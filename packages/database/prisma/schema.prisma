generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

model Payment {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idempotencyKey String          @unique @map("idempotency_key")
  requestHash    String          @map("request_hash")
  amountMinor    BigInt          @map("amount_minor")
  currency       String          @db.VarChar(3)
  status         PaymentStatus   @default(COMPLETED)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  ledgerEntries  LedgerEntry[]
  deliveries    WebhookDelivery[]

  @@map("payments")
}

model WebhookDelivery {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId    String   @map("event_id")
  paymentId  String   @map("payment_id") @db.Uuid
  payment    Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@index([eventId])
  @@index([paymentId])
  @@map("webhook_deliveries")
}

model LedgerEntry {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId   String          @map("payment_id") @db.Uuid
  payment     Payment         @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  account     String
  direction   LedgerDirection
  amountMinor BigInt          @map("amount_minor")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([paymentId])
  @@map("ledger_entries")
}

model ControllerPolicy {
  id              String   @id
  version         Int      @default(1)
  enabled         Boolean  @default(true)
  targetService   String   @map("target_service")
  condition       String
  action          String
  breachCount     Int      @map("breach_count")
  cooldownMs      Int      @map("cooldown_ms")
  maxRestarts     Int      @map("max_restarts")
  restartWindowMs Int      @map("restart_window_ms")
  pollIntervalMs  Int      @map("poll_interval_ms")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("controller_policies")
}
