{
  "name": "postgres-latency-peak",
  "hypothesis": "PostgreSQL latency at peak load causes bounded request failures without duplicate or lost committed payments.",
  "target": "api-postgres",
  "fault": "FS_4",
  "fs4": {
    "proxy": "api-postgres",
    "toxic": "latency",
    "stream": "downstream",
    "inject_after_s": 1.429,
    "latency_ms": 750,
    "jitter_ms": 100
  },
  "controller": {
    "enabled": false,
    "port": 3100,
    "restart_during_outage": false
  },
  "seed": 2008,
  "repeat": 1,
  "duration_s": 10,
  "rate_per_second": 50,
  "invariant_drain_timeout_s": 60,
  "duplicate_observation_s": 0,
  "max_duration_s": 120,
  "recovery": {
    "timeout_s": 30,
    "consecutive_healthy": 2
  },
  "steady_state": {
    "max_error_rate": 0.02
  },
  "abort_if": {
    "error_rate_above": 1
  },
  "invariants": [
    "I1",
    "I2",
    "I3",
    "I4",
    "I5",
    "I6"
  ]
}
